<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFrameworks>net5.0-windows;net6.0-windows;net7.0-windows;net8.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>NullSoftware</RootNamespace>
    <AssemblyName>awp_wpf</AssemblyName>
    <PackageId>AutoWindowPlacement.WPF</PackageId>
    <Authors>Null Software</Authors>
    <Product>AutoWindowPlacement for WPF</Product>
    <Description>AutoWindowPlacement provides ability for WPF to preserve Window position and state between sessions.</Description>
    <RepositoryUrl>https://github.com/nullsoftware/AutoWindowPlacement.WPF</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/nullsoftware/AutoWindowPlacement.WPF</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright © Null Software, 2026. All rights reserved.</Copyright>
    <PackageTags>WPF Windows Registry Window Position State WindowState Placement WindowPlacement Win32</PackageTags>
  </PropertyGroup>

</Project>
